{
  "system": "basic_rag",
  "model": "deepseek",
  "temperature": 1.0,
  "retrieval": {
    "enabled": true,
    "backend": "onnx_minilm",
    "chroma_dir_env": "CHROMA_LAYER1_DIR",
    "top_k": 4,
    "sparse": false,
    "fusion": "none",
    "rerank": false
  },
  "decision": {
    "enabled": false
  },
  "grounding": {
    "enabled": false
  },
  "citations": {
    "enabled": false
  },
  "answer": {
    "prompt_template": "请根据下面提供的参考资料回答问题。若参考资料不足以回答，请用你自己的知识补充。\n参考资料：\n{evidence}\n\n问题：{question}\n"
  }
}