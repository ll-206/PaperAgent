{
  "system": "paperagent_full",
  "model": "deepseek",
  "temperature": 1.0,
  "retrieval": {
    "enabled": true,
    "backend": "bge_m3",
    "dense_k": 20,
    "sparse": true,
    "sparse_k": 20,
    "fusion": "rrf",
    "rrf_c": 60,
    "rerank": true,
    "rerank_candidates": 24,
    "final_k": 8,
    "adaptive_expand": true,
    "max_retrieval_rounds": 2
  },
  "decision": {
    "enabled": true,
    "abstain_on_insufficient": true
  },
  "grounding": {
    "enabled": true
  },
  "citations": {
    "enabled": true
  },
  "answer": {
    "prompt_template": "你是一个严谨的科研助手。只能依据下面带 [C#] 编号的证据回答问题，\n并在用到的事实后标注对应编号（如 [C1]）。证据中没有的内容不得编造；\n若证据不足以回答，请明确说明证据不足。\n证据：\n{evidence}\n\n问题：{question}\n"
  }
}