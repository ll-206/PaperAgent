# Copy to .env.prod for the production build, or .env.dev for local development.
# /api is proxied by nginx to the FastAPI service on 127.0.0.1:8001.
VITE_DEPLOY_BASE_URL=/
VITE_API_BASE_URL=/api
VITE_APP_DEFAULT_THEME=light
VITE_APP_NAME=PaperAgent
VITE_APP_TITLE=PaperAgent
VITE_APP_DESC=AI-powered paper reading and research assistant
VITE_APP_KEYWORDS=PaperAgent,AI,RAG,paper,research
VITE_STORAGE_PREFIX=paperagent
